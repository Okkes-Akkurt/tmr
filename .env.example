# Supabase > Project Settings > API (veya "Connect" penceresi)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Sadece sunucuda kullanılır; asla NEXT_PUBLIC_ ile başlatmayın, repoya koymayın.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Sitenin yayındaki adresi (sitemap, canonical ve hreflang için)
NEXT_PUBLIC_SITE_URL=https://www.tmrengineering.com.tr

# Rastgele uzun bir metin (IP adreslerini açık tutmadan hız sınırı için özetlemede kullanılır)
LEAD_HASH_SALT=degistirin-uzun-rastgele-bir-metin

# İsteğe bağlı: yeni teklif talebinde e-posta bildirimi (resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_TO=info@tmrengineering.com.tr
LEAD_NOTIFY_FROM=TMR Web <bildirim@tmrengineering.com.tr>
